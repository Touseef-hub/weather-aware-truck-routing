DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Routing (public OSRM demo by default; self-host or swap for production use)
OSRM_BASE_URL=https://router.project-osrm.org
# Trucks are slower than the car profile OSRM uses; durations are multiplied by this.
TRUCK_DURATION_FACTOR=1.15
# Nominatim requires an identifying User-Agent
GEOCODER_USER_AGENT=spotter-weather-routing/1.0 (contact: you@example.com)
